# regpulse — environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# ── PostgreSQL ──────────────────────────────────────────────────────────
# Hostname of the PostgreSQL server (Docker service name or IP)
POSTGRES_HOST=postgres
# Port on which PostgreSQL listens
POSTGRES_PORT=5432
# Database name for regpulse (created automatically if it does not exist)
POSTGRES_DB=knowledge_base
# Database user with full access to the regpulse database
POSTGRES_USER=postgres
# Password for the PostgreSQL user (required — no default, set a strong value)
POSTGRES_PASSWORD=change_me
# Full connection string (used by pdf_export.py — constructed from above vars if omitted)
POSTGRES_DSN=postgresql://postgres:change_me@postgres:5432/knowledge_base

# ── Qdrant ─────────────────────────────────────────────────────────────
# Hostname of the Qdrant vector database (Docker service name or IP)
QDRANT_HOST=qdrant
# REST API port on the Qdrant server
QDRANT_PORT=6333
# Name of the Qdrant collection storing document chunks
QDRANT_COLLECTION=knowledge_base

# ── Ollama ─────────────────────────────────────────────────────────────
# Hostname of the Ollama LLM server (Docker service name or IP)
OLLAMA_HOST=ollama
# API port on the Ollama server
OLLAMA_PORT=11434
# Default generation model (must already be pulled in Ollama)
OLLAMA_GEN_MODEL=phi4:14b-q8_0
# Default embedding model (must already be pulled in Ollama)
OLLAMA_EMBED_MODEL=mxbai-embed-large

# ── Langfuse ───────────────────────────────────────────────────────────
# Public key from your Langfuse project settings (optional — tracing is disabled if left empty)
LANGFUSE_PUBLIC_KEY=
# Secret key from your Langfuse project settings
LANGFUSE_SECRET_KEY=
# Base URL of the Langfuse server (Docker service name or full URL)
LANGFUSE_HOST=http://langfuse:3000

# ── Docling ────────────────────────────────────────────────────────────
# Base URL of the Docling document conversion service
DOCLING_HOST=http://docling:5001

# ── Hugging Face ───────────────────────────────────────────────────────
# Hugging Face token for accessing gated models (optional)
HF_TOKEN=

# ── API ────────────────────────────────────────────────────────────────
# Host port to expose the regpulse API on
API_PORT=8001
# Directory for persistent regpulse data (run logs, exports, query history)
DATA_DIR=./data/api
# Absolute path to the regulatory document archive (PDF sources for ingestion)
REGULATORY_ARCHIVE_PATH=./data/regulatory_archive
# Absolute path to shared scripts directory (optional, mounted read-only)
SCRIPTS_PATH=./scripts
# Path to the RSS pipeline entry point (used by the scheduler)
PIPELINE_SCRIPT=/opt/scripts/rss/run_pipeline.py

# ── RSS Feed Scheduler ─────────────────────────────────────────────────
# Hour of the day to run the scheduled RSS feed fetch (0–23)
RSS_SCHEDULE_HOUR=9
# Minute of the hour to run the scheduled RSS feed fetch (0–59)
RSS_SCHEDULE_MINUTE=0
# Timezone for RSS schedule interpretation (IANA timezone name)
RSS_SCHEDULE_TIMEZONE=Europe/Berlin

# ── Frontend (Vite) ────────────────────────────────────────────────────
# Host port to expose the regpulse UI dev server on
UI_PORT=5173
# API base URL for the frontend (leave empty for same-origin reverse-proxy)
VITE_API_URL=
# Disable Vite hot-module replacement when running inside Docker
VITE_HMR_DISABLED=true
