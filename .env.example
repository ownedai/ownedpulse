# ownedpulse — environment configuration
# Copy to .env, fill in your values, then run ./install.sh
# .env is git-ignored and must never be committed.

# ── Service modes ─────────────────────────────────────────────────────────
# Each service defaults to "bundled" (Docker container managed by install.sh).
# Set to "external" if you already run the service elsewhere — the matching
# *_HOST / *_PORT / credential vars must also be set.

# POSTGRES_MODE=bundled
# QDRANT_MODE=bundled
# OLLAMA_MODE=bundled
# DOCLING_MODE=bundled
# LANGFUSE_MODE=bundled

# ── Host ports ─────────────────────────────────────────────────────────
# Ports published on the host. Change any of these if the port is already
# taken on your machine. Services always talk to each other over fixed
# container-internal ports (5432 / 6333 / 11434 / 5001 / 3000), so changing
# a host port never breaks inter-service wiring.
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
OLLAMA_HOST_PORT=11434
DOCLING_HOST_PORT=5001
LANGFUSE_HOST_PORT=3001

# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_HOST=ownedpulse-postgres
POSTGRES_DB=knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# POSTGRES_PORT=5432   # external mode only — port the remote PostgreSQL listens on
# POSTGRES_DSN=postgresql://postgres:<POSTGRES_PASSWORD>@ownedpulse-postgres:5432/knowledge_base

# ── Qdrant ─────────────────────────────────────────────────────────────
QDRANT_HOST=ownedpulse-qdrant
QDRANT_COLLECTION=knowledge_base
# QDRANT_PORT=6333     # external mode only — port the remote Qdrant listens on

# ── Ollama ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://ownedpulse-ollama:11434
OLLAMA_GEN_MODEL=phi4:14b-q8_0
OLLAMA_EMBED_MODEL=mxbai-embed-large
# OLLAMA_PORT=11434    # external mode only — port the remote Ollama listens on
# Context size requested for every call that loads the generation model. Ollama
# keeps one runner per (model, context size), so a second value evicts the first
# and forces a full model reload. If this Ollama is shared, every other client
# must use the same value for the same model.
OLLAMA_NUM_CTX=12288
# Seconds to wait for the generation model before returning a 504. Generation
# on a busy or memory-constrained GPU can take well over a minute.
OLLAMA_TIMEOUT=180

# ── API runtime ────────────────────────────────────────────────────────
# Restart the API when a file under api/ changes. For development only: the
# directory is bind-mounted, so a reload interrupts whatever ingestion is
# running. Only the exact value "true" enables it.
UVICORN_RELOAD=false

# ── Docling ────────────────────────────────────────────────────────────
DOCLING_HOST=http://ownedpulse-docling:5001
DOCLING_VARIANT=gpu   # gpu (default) | cpu — cpu frees VRAM; slower PDF parsing

# ── Langfuse (bundled by default) ──────────────────────────────────────
LANGFUSE_HOST=http://ownedpulse-langfuse:3000
# LANGFUSE_URL=http://localhost:3001   # defaults to LANGFUSE_HOST_PORT above
LANGFUSE_PUBLIC_KEY=           # auto-generated by install.sh — leave empty
LANGFUSE_SECRET_KEY=           # auto-generated by install.sh — leave empty
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_PASSWORD=change_me  # set a strong password for the langfuse DB user
LANGFUSE_NEXTAUTH_SECRET=change_me   # generate with: openssl rand -hex 32
LANGFUSE_SALT=change_me              # generate with: openssl rand -hex 16
LANGFUSE_INIT_USER_EMAIL=admin@ownedpulse.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=change_me  # set a strong admin password
LANGFUSE_INIT_ORG_ID=ownedpulse-org
LANGFUSE_INIT_ORG_NAME=OwnedPulse
LANGFUSE_INIT_PROJECT_ID=ownedpulse-project
LANGFUSE_INIT_PROJECT_NAME=OwnedPulse

# ── Hugging Face ───────────────────────────────────────────────────────
# HF_TOKEN=                     # optional — for gated models

# ── API ────────────────────────────────────────────────────────────────
API_PORT=8001
DATA_DIR=./data/api
REGULATORY_ARCHIVE_PATH=./data/regulatory_archive
SCRIPTS_PATH=./scripts
# PIPELINE_SCRIPT=/opt/scripts/rss/run_pipeline.py

# ── RSS Feed Scheduler ─────────────────────────────────────────────────
# RSS_SCHEDULE_HOUR=9
# RSS_SCHEDULE_MINUTE=0
# RSS_SCHEDULE_TIMEZONE=Europe/Berlin

# ── Frontend (Vite) ────────────────────────────────────────────────────
UI_PORT=5173
# VITE_API_URL=
# VITE_HMR_DISABLED=true
# Comma-separated hostnames the Vite dev server will answer for. Leave unset
# for localhost only; set when serving the UI through a proxy or tunnel.
# VITE_ALLOWED_HOSTS=example.com,example.internal
